# Talking objects — configuration
#
# Copy to config.env and fill in. config.env is in .gitignore: it never
# travels with the repo. The environment wins over this file.

# --- Voice providers --------------------------------------------------------
# auto        Vidiv first, ElevenLabs as automatic fallback (recommended)
# vidiv       Vidiv only
# elevenlabs  ElevenLabs only
PROVIDER_MODE=auto

# Vidiv (mints the token) + LiveKit (carries the audio)
# The slug is not a key, but whoever has it can talk to your agent and spend
# your quota: treat it as semi-secret.
VIDIV_AGENT_SLUG=
LIVEKIT_URL=
# VIDIV_API_BASE=https://api.vidiv.net
LANGUAGE=es

# ElevenLabs Agents (the fallback). Without these, the object still starts,
# on Vidiv alone, with a warning in the log.
ELEVENLABS_AGENT_ID=
ELEVENLABS_API_KEY=

# Circuit breaker: failures before a provider gives up first place, and for how long.
BREAKER_FAILURES=2
BREAKER_COOLDOWN_S=300

# --- Trigger ----------------------------------------------------------------
# gpio | keyboard | auto
TRIGGER_MODE=gpio
TRIGGER_GPIO=17
TRIGGER_BOUNCE_MS=300
TRIGGER_INVERT=0
AUTO_PAUSE_S=20
MAX_CALL_SECONDS=600

# --- Audio ------------------------------------------------------------------
AUDIO_SAMPLE_RATE=48000
AUDIO_CHANNELS=1
AUDIO_BLOCK_MS=20
# AUDIO_INPUT_DEVICE=
# AUDIO_OUTPUT_DEVICE=
# Raise if the agent hears itself and cuts off; lower if it is hard to interrupt.
MIC_DUCK_DB=12
# FAKE_AUDIO=1 replaces the sound card with silence (development on a laptop).
FAKE_AUDIO=0

# --- Light and screen -------------------------------------------------------
LED_COUNT=60
LED_BRIGHTNESS=0.35
# Color at rest, "R,G,B", or off.
LED_IDLE_COLOR=40,30,20
# I2C address of a 20x4 LCD (check with: i2cdetect -y 1). Empty = no screen.
LCD_ADDRESS=

# --- Reactor and MCP link ---------------------------------------------------
RULES_PATH=rules.toml
# Outbound tunnel to your Worker: wss://<worker>/device/connect?key=<DEVICE_KEY>
LINK_URL=

# --- Status and privacy -----------------------------------------------------
STATUS_PORT=8081
# Transcripts are personal data. Keep this at 0 in public spaces unless
# someone decided otherwise, on purpose and with notice to visitors.
STORE_TRANSCRIPTS=0
